// bz zellij config
// Clear all defaults - we're using zellij as a TUI base, not a multiplexer

keybinds clear-defaults=true {
    // Normal mode - where we spend most of our time
    normal {
        // Ctrl+k: open channel picker
        bind "Ctrl k" {
            Run "bash" "-c" "$BZ_ROOT/scripts/picker.sh" {
                floating true
                hold_on_close false
            }
        }
        // Ctrl+q: enter quit confirmation mode
        bind "Ctrl q" { SwitchToMode "Session"; }
    }

    // Session mode - used for quit confirmation
    session {
        // Second Ctrl+q confirms quit
        bind "Ctrl q" { Quit; }
        // Anything else cancels
        bind "Esc" { SwitchToMode "Normal"; }
        // Any other key also cancels back to normal
        bind "Enter" { SwitchToMode "Normal"; }
    }

    // Disable all other modes by leaving them empty
    locked {}
    pane {}
    tab {}
    resize {}
    move {}
    search {}
    scroll {}
    renametab {}
    renamepane {}
}

// Hide the default UI - we have our own sidebar
pane_frames false
simplified_ui true

// Theme - keep it minimal
theme "default"

// Don't show the default status bar or tab bar
default_layout "compact"
